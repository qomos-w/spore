#!/bin/sh
#
# pre-push hook: refuse to publish a tag until the commit it points at is
# already on the remote's main branch.
#
# Rationale: v0.4.0 was tagged and the tag pushed *before* main had been pushed,
# so the release tag reached the remote pointing at a commit the remote's main
# did not contain. This hook turns "push main first, then push the tag" into a
# hard rule for every tag push.
#
# Install with scripts/install-hooks.sh (it points core.hooksPath at this
# directory). The check is deliberately bypassable with --no-verify for the rare
# case where a tag must be published against a non-main commit.

remote_name="$1"
remote_url="$2"

# Collect the tags being pushed (newline-separated "ref commit" pairs) and the
# oid main is being moved to in this same push, if any.
tags=""
push_main_oid=""

while read -r local_ref local_oid remote_ref remote_oid; do
	case "$local_ref" in
	refs/tags/*)
		# Tag deletion (all-zero oid) is always allowed.
		if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
			continue
		fi
		# Peel annotated tags down to their commit; lightweight tags resolve
		# to themselves.
		commit=$(git rev-parse --verify --quiet "${local_oid}^{commit}") || commit="$local_oid"
		tags="${tags}${local_ref} ${commit}
"
		;;
	refs/heads/main)
		push_main_oid="$local_oid"
		;;
	esac
done

# Nothing to check if no tag is being pushed.
[ -n "$tags" ] || exit 0

# Effective state of the remote's main *after* this push: the oid being pushed
# in this same command (main + tag together is fine), otherwise whatever the
# remote currently has.
if [ -n "$push_main_oid" ]; then
	remote_main="$push_main_oid"
else
	if ! ls_out=$(git ls-remote --heads "$remote_url" refs/heads/main 2>/dev/null); then
		echo "pre-push: warning: cannot query $remote_url for main; skipping tag-order check" >&2
		exit 0
	fi
	remote_main=$(printf '%s\n' "$ls_out" | awk 'NR==1 {print $1}')
fi

fail=0
while read -r ref commit; do
	[ -n "$ref" ] || continue

	if [ -z "$remote_main" ]; then
		echo "pre-push: REFUSED $ref — $remote_name has no main branch yet" >&2
		fail=1
		continue
	fi
	if ! git cat-file -e "${remote_main}^{commit}" 2>/dev/null; then
		echo "pre-push: REFUSED $ref — cannot verify $remote_name/main (object $remote_main is not local); run 'git fetch $remote_name main' first" >&2
		fail=1
		continue
	fi
	if git merge-base --is-ancestor "$commit" "$remote_main" 2>/dev/null; then
		continue
	fi

	echo "pre-push: REFUSED $ref — commit ${commit} is not on $remote_name/main" >&2
	fail=1
done <<EOF
$tags
EOF

if [ "$fail" -ne 0 ]; then
	cat >&2 <<'MSG'

A tag was about to be published whose commit main does not have — the exact
ordering that caused the v0.4.0 tag-first incident. Push main first, wait for it
to land, then push the tag:

    git push <remote> main
    git push <remote> <tag>

(Override deliberately with: git push --no-verify <remote> <tag>)
MSG
	exit 1
fi

exit 0
